ARG ROS_BASE_IMAGE=ros:jazzy-ros-base-noble
FROM ${ROS_BASE_IMAGE}

ARG APEX_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONNOUSERSITE=1 \
    ROS_DISTRO=jazzy

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-pip \
      python3-yaml \
      ros-jazzy-geometry-msgs \
      ros-jazzy-rmw-cyclonedds-cpp \
      ros-jazzy-rosbag2-py \
      ros-jazzy-rosbag2-storage-mcap \
      ros-jazzy-rosidl-default-generators \
      ros-jazzy-std-msgs \
      ros-jazzy-std-srvs \
    && rm -rf /var/lib/apt/lists/*

COPY UI_node/apex_backend/docker/requirements-jazzy.lock /tmp/requirements.lock
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      --index-url "${APEX_PIP_INDEX_URL}" \
      --requirement /tmp/requirements.lock \
    && rm -f /tmp/requirements.lock

WORKDIR /opt/apex_ws
COPY mobile_base/interface/move src/move
COPY robot_node/marvin_msgs src/marvin_msgs
COPY UI_node/apex_backend src/apex_backend
RUN source /opt/ros/jazzy/setup.bash \
    && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf build log src

# Some ROS base images already reserve UID/GID 1000.  Reuse those numeric
# identities when present; the production unit supplies the host UID/GID at
# docker run time, so a named image user is not required here.
RUN if ! getent group 1000 >/dev/null 2>&1; then \
      groupadd --gid 1000 apex; \
    fi \
    && if ! getent passwd 1000 >/dev/null 2>&1; then \
      useradd --uid 1000 --gid 1000 --create-home --home-dir /home/apex --shell /bin/bash apex; \
    fi \
    && install -d -o 1000 -g 1000 /home/apex /var/log/apex/ros/backend-container

COPY --chmod=0755 UI_node/apex_backend/docker/backend-entrypoint.sh /usr/local/bin/apex-backend-entrypoint

USER 1000:1000
ENTRYPOINT ["/usr/local/bin/apex-backend-entrypoint"]
CMD ["ros2", "run", "apex_backend", "backend"]
